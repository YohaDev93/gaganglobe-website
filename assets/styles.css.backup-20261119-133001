@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
    --navy: #071b38;
    --navy2: #102d4c;
    --gold: #d5aa53;
    --cream: #f7f7f4;
    --ink: #18293d;
    --muted: #657282;
    --line: #e2e6e9
}

* {
    box-sizing: border-box
}

html {
    scroll-behavior: smooth
}

body {
    margin: 0;
    color: var(--ink);
    background: white;
    font-family: 'DM Sans', Arial, sans-serif;
    line-height: 1.65
}

h1,
h2,
h3,
h4 {
    font-family: 'Manrope', Arial, sans-serif;
    line-height: 1.18;
    letter-spacing: -.035em
}

h1 {
    font-size: clamp(2.4rem, 5vw, 4.65rem);
    margin: 14px 0 22px
}

h2 {
    font-size: clamp(2rem, 3.2vw, 3rem);
    margin: 8px 0 16px
}

h3 {
    font-size: 1.24rem;
    margin: 10px 0
}

p {
    margin: 0 0 18px
}

a {
    text-decoration: none;
    color: inherit
}

.wrap {
    max-width: 1180px;
    padding: 0 26px;
    margin: 0 auto
}

.topline {
    background: var(--navy);
    color: #d9e3eb;
    font-size: 12px;
    padding: 8px 0
}

.topline .wrap {
    display: flex;
    justify-content: space-between;
    gap: 15px
}

.topline a {
    color: #ebc879
}

.nav {
    position: sticky;
    top: 0;
    background: #fff;
    z-index: 30;
    box-shadow: 0 1px 12px #071b3812
}

.navrow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 90px;
    gap: 20px
}

.brand {
    display: flex;
    align-items: center;
    gap: 11px;
    font-weight: 800;
    font-size: 16px;
    line-height: 1.2
}

.brand img {
    width: 67px;
    height: 67px;
    object-fit: contain
}

.brand small {
    display: block;
    font-size: 9px;
    letter-spacing: .075em;
    font-weight: 600;
    color: #8a733f;
    margin-top: 5px
}

.links {
    display: flex;
    align-items: center;
    gap: 21px
}

.links a {
    font-size: 13px;
    font-weight: 700;
    color: #233449
}

.links a:hover,
.links a.active {
    color: #ac8032
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--gold);
    color: var(--navy);
    padding: 13px 22px;
    border-radius: 6px;
    font-weight: 800;
    font-size: 14px;
    border: 1px solid var(--gold);
    transition: .2s
}

.btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.06)
}

.btn.outline {
    background: transparent;
    color: #fff;
    border-color: #ffffff80
}

.links .btn {
    color: var(--navy)
}

.menu-toggle {
    display: none;
    border: 0;
    background: transparent;
    font-size: 28px;
    cursor: pointer
}

.hero {
    background: linear-gradient(105deg, #071b38ed, #0a2852d9), radial-gradient(circle at 80% 30%, #d7ad5270, transparent 45%);
    color: white;
    overflow: hidden
}

.hero-grid {
    min-height: 615px;
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: 45px;
    align-items: center;
    padding-top: 60px;
    padding-bottom: 70px
}

.eyebrow {
    color: #af8436;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: .17em;
    font-size: 12px
}

.hero .eyebrow {
    color: #ebc77b
}

.hero p {
    font-size: 17px;
    color: #dce5ec;
    max-width: 650px
}

.hero .actions,
.actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 30px
}

.hero-art {
    position: relative
}

.hero-art img {
    width: 100%;
    max-width: 420px;
    display: block;
    margin: auto;
    filter: drop-shadow(0 22px 22px #020f2399)
}

.hero-art:before {
    content: '';
    position: absolute;
    inset: 16% 3%;
    border-radius: 50%;
    border: 1px solid #d6a94f66
}

.strip {
    background: #f6f3ec;
    border-bottom: 1px solid #eae1d2;
    padding: 17px 0
}

.strip .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    color: #3a4452;
    font-size: 13px;
    font-weight: 700
}

.section {
    padding: 68px 0
}

.section.soft {
    background: #f7f8f9
}
.section.guide {
    background: #4c797a
}
.eyebrow.guide{
    color:#fff;
}
.guide{
    color: aliceblue;
}
.cards .guide{
    color: #565151;
}
.section.dark {
    background: var(--navy);
    color: #fff
}

.section.dark p {
    color: #c7d4e0
}

.lead {
    max-width: 755px;
    font-size: 17px;
    color: var(--muted)
}

.introgrid,
.split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center
}

.section-img {
    width: 100%;
    border-radius: 13px;
    display: block;
    aspect-ratio: 1.5;
    object-fit: cover;
    box-shadow: 0 20px 60px #0e27441c
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 35px
}

.card {
    background: white;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 9px 24px #122b3b0a;
    transition: .2s
}

.card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px #122b3b17
}

.card>img {
    width: 100%;
    height: 175px;
    object-fit: cover;
    display: block
}

.cardbody {
    padding: 24px
}

.card p {
    color: var(--muted);
    font-size: 14px
}

.card a.link {
    color: #8b662b;
    font-weight: 800;
    font-size: 13px
}

.statline {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 30px
}

.stat {
    border-left: 3px solid var(--gold);
    padding-left: 17px;
    font-size: 14px;
    color: var(--muted)
}

.stat strong {
    display: block;
    color: var(--navy);
    font-size: 18px
}

.band {
    background: #e9edee;
    padding: 43px 0
}

.band-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px
}

.band-inner h2 {
    margin: 0
}

.footer {
    background: #07182f;
    color: #d2dce5;
    padding: 60px 0 24px
}

.footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 44px
}

.footer h3 {
    color: #fff
}

.footer a {
    display: block;
    margin: 8px 0;
    font-size: 14px;
    color: #d8e2e9
}

.footer small {
    color: #9eb0c2
}

.footer-bottom {
    border-top: 1px solid #ffffff26;
    margin-top: 40px;
    padding-top: 19px;
    font-size: 12px;
    color: #a9b8c6
}

.pagehero {
    background: linear-gradient(112deg, #071b38, #1a4668);
    color: #fff;
    padding: 84px 0
}

.pagehero h1 {
    font-size: clamp(2.3rem, 4vw, 3.8rem)
}

.pagehero p {
    color: #d1dce8;
    max-width: 650px;
    font-size: 17px
}

.tag {
    display: inline-block;
    border: 1px solid #dbc49c;
    border-radius: 40px;
    padding: 4px 12px;
    font-size: 12px;
    color: #906c31;
    background: #faf6eb;
    margin: 3px
}

.steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-top: 30px
}

.step {
    padding: 26px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid var(--line)
}

.step b {
    font-size: 23px;
    color: #ba8c3d
}

.note {
    padding: 18px;
    border-left: 4px solid #d5aa53;
    background: #fff8e9;
    font-size: 14px;
    color: #675630;
    border-radius: 4px
}

.contact-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 30px
}

.contact-option {
    background: #fff;
    border: 1px solid var(--line);
    padding: 27px;
    border-radius: 10px
}

.contact-option a {
    font-size: 18px;
    font-weight: 800;
    color: #1e4f77
}

.form-note {
    font-size: 13px;
    color: var(--muted)
}

.jobs {
    background: #f5f7f8;
    padding: 25px;
    border-radius: 12px
}

.quote {
    font-family: Manrope, sans-serif;
    font-size: 23px;
    font-weight: 700
}

.pill {
    background: #f5efe1;
    color: #77581f;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700
}

.image-caption {
    font-size: 12px;
    color: #8b95a0;
    margin-top: 7px
}

@media(max-width:900px) {
    .links {
        display: none;
        position: absolute;
        top: 90px;
        left: 0;
        right: 0;
        background: #fff;
        padding: 22px 25px;
        flex-direction: column;
        align-items: flex-start;
        box-shadow: 0 15px 30px #05132422
    }

    .links.open {
        display: flex
    }

    .menu-toggle {
        display: block
    }

    .hero-grid,
    .introgrid,
    .split {
        grid-template-columns: 1fr
    }

    .hero-grid {
        gap: 0;
        padding-top: 42px
    }

    .hero-art img {
        max-width: 300px
    }

    .cards {
        grid-template-columns: repeat(2, 1fr)
    }

    .steps {
        grid-template-columns: repeat(2, 1fr)
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr
    }
}

@media(max-width:620px) {
    .wrap {
        padding: 0 19px
    }

    .section {
        padding: 43px 0
    }

    .cards,
    .steps,
    .statline,
    .contact-options,
    .footer-grid {
        grid-template-columns: 1fr
    }

    .topline .wrap {
        display: block
    }

    .band-inner {
        display: block
    }

    .band-inner .btn {
        margin-top: 20px
    }

    .brand {
        font-size: 12px
    }

    .brand img {
        width: 53px;
        height: 53px
    }

    .navrow {
        min-height: 75px
    }

    .links {
        top: 75px
    }

    .hero-grid {
        min-height: 0
    }

    .hero-art img {
        max-width: 235px
    }

    .pagehero {
        padding: 56px 0
    }
}

.enquiry-form {
    margin-top: 22px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 9px 24px #122b3b0a
}

.field-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 18px
}

.field {
    display: flex;
    flex-direction: column;
    gap: 8px
}

.field-full {
    grid-column: 1/-1
}

.field label {
    font-size: 13px;
    font-weight: 700;
    color: #243548
}

.field input,
.field select,
.field textarea {
    width: 100%;
    padding: 13px 14px;
    border-radius: 8px;
    border: 1px solid #d6dde4;
    font: inherit;
    color: var(--ink);
    background: #fff
}

.field input:focus,
.field select:focus,
.field textarea:focus {
    outline: none;
    border-color: #d5aa53;
    box-shadow: 0 0 0 3px #d5aa5322
}

.contact-option h3 {
    margin-bottom: 8px
}

.pagehero p strong,
.form-note strong {
    color: var(--navy)
}

@media(max-width:620px) {
    .field-grid {
        grid-template-columns: 1fr
    }

    .enquiry-form {
        padding: 18px
    }
}

/* GGC V8 hero banner — accessible responsive carousel */
.hero-carousel {
    position: relative;
    background: linear-gradient(120deg, #071b38 0%, #0c2d55 100%);
    color: #fff;
    overflow: hidden
}

.hero-slides {
    position: relative;
    min-height: 565px
}

.hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .55s ease, visibility .55s ease
}

.hero-slide.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    pointer-events: auto
}

.hero-slide-grid {
    display: grid;
    grid-template-columns: 1.02fr .98fr;
    align-items: center;
    gap: 50px;
    min-height: 565px;
    padding-top: 53px;
    padding-bottom: 45px
}

.hero-copy {
    padding-bottom: 18px
}

.hero-copy h1 {
    font-size: clamp(2.45rem, 4.5vw, 4.2rem);
    max-width: 660px;
    margin: 12px 0 20px
}

.hero-copy p {
    font-size: 17px;
    line-height: 1.7;
    color: #d7e4f0;
    max-width: 590px
}

.hero-copy .actions {
    margin-top: 30px
}

.hero-image-frame {
    height: 420px;
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid #ffffff26;
    box-shadow: 0 28px 65px #020b1d70
}

.hero-image-frame:before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, #06162e77, transparent 35%);
    z-index: 1;
    pointer-events: none
}

.hero-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block
}

.photo-caption {
    position: absolute;
    z-index: 2;
    bottom: 14px;
    right: 16px;
    font-size: 11px;
    letter-spacing: .035em;
    color: #f2f5f8;
    background: #081b31ad;
    padding: 5px 9px;
    border-radius: 4px
}

.hero-carousel-controls {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 30px;
    gap: 18px
}

.hero-dots,
.hero-arrow-group {
    display: flex;
    align-items: center;
    gap: 10px
}

.hero-dot {
    border: 0;
    background: transparent;
    padding: 8px 2px;
    cursor: pointer;
    min-width: 40px;
    min-height: 30px
}

.hero-dot span {
    height: 5px;
    width: 36px;
    background: #ffffff5e;
    display: block;
    border-radius: 10px;
    transition: background .2s, width .2s
}

.hero-dot.is-active span {
    background: var(--gold);
    width: 43px
}

.hero-arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #ffffff77;
    color: #fff;
    background: #ffffff15;
    font-size: 22px;
    cursor: pointer
}

.hero-arrow:hover {
    background: #ffffff2c
}

.hero-dot:focus-visible,
.hero-arrow:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px
}

@media(max-width:900px) {
    .hero-slides {
        min-height: 0
    }

    .hero-slide-grid {
        grid-template-columns: 1fr;
        gap: 24px;
        padding-top: 38px;
        padding-bottom: 32px;
        min-height: 0
    }

    .hero-copy {
        padding: 0
    }

    .hero-image-frame {
        height: 290px
    }

    .hero-copy h1 {
        font-size: clamp(2.35rem, 6vw, 3.4rem)
    }
}

@media(max-width:620px) {
    .hero-slide-grid {
        padding-top: 35px;
        gap: 24px
    }

    .hero-image-frame {
        height: 220px
    }

    .hero-copy h1 {
        font-size: 2.2rem
    }

    .hero-copy p {
        font-size: 15px
    }

    .hero-carousel-controls {
        padding-bottom: 19px
    }

    .hero-arrow {
        width: 40px;
        height: 40px
    }

    .hero-dot {
        min-width: 31px
    }

    .hero-dot span {
        width: 26px
    }

    .hero-dot.is-active span {
        width: 32px
    }
}

@media(prefers-reduced-motion:reduce) {
    .hero-slide {
        transition: none
    }

    .hero-dot span {
        transition: none
    }
}